# Hugging Face API tokeninizi buraya qoyun (bu fayl nümunədir, əsl tokeni .env faylında saxlayın)
# Pulsuz token almaq üçün: https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# İstəyə bağlı: istifadə olunacaq modellər
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
